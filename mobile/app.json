{
  "expo": {
    "name": "Candela IA",
    "slug": "candela-ia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-candela.png",
    "scheme": "candelaia",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo-candela.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.candelaia.app"
    },
    "android": {
      "package": "com.candelaia.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-candela.png",
        "backgroundColor": "#09090B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResources": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "60bfb56c-3d43-40d3-9079-10d5fd4d4ee2"
      }
    },
    "owner": "candela-ia",
    "updates": {
      "url": "https://u.expo.dev/60bfb56c-3d43-40d3-9079-10d5fd4d4ee2"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
