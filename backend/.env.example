# Copia este archivo a `.env` y rellena los valores.
# El .env NUNCA va al repositorio.

# ── Base de datos ────────────────────────────────────────────────────────
# Formato: mysql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL="mysql://root:tu_password@localhost:3306/candela_ia"

# ── IA ───────────────────────────────────────────────────────────────────
# "openai" (por defecto) o "mock".
#
# El modo mock devuelve frases escritas a mano con latencia realista. Sirve
# para construir toda la app sin API key y sin gastar nada.
# ⚠️ NUNCA lo pongas en producción: servirías frases enlatadas.
AI_PROVIDER="mock"

# La generas en https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5.6-luna"

# ── Autenticación ────────────────────────────────────────────────────────
# Firma los JWT que identifican al dispositivo.
# Genera uno aleatorio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia_esto_por_algo_aleatorio_y_largo"
JWT_EXPIRES_IN="30d"

# ── RevenueCat ───────────────────────────────────────────────────────────
# Para validar la firma de los webhooks de suscripción.
REVENUECAT_WEBHOOK_SECRET=""

# ── Servidor ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Documentación ────────────────────────────────────────────────────────
# En producción Swagger se apaga solo: describe la API entera, que es justo
# lo que necesitaría alguien para atacarla. Ponlo en "true" únicamente si
# necesitas enseñársela a alguien, y vuelve a quitarlo después.
SWAGGER="false"
