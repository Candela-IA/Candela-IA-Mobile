{
  "expo": {
    "name": "Candela IA",
    "slug": "candela-ia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-candela.png",
    "scheme": "candelaia",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo-candela.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.candelaia.app"
    },
    "android": {
      "package": "com.candelaia.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-candela.png",
        "backgroundColor": "#09090B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
