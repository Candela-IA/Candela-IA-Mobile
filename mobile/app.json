{
  "expo": {
    "name": "Candela IA",
    "slug": "candela-ia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-candela.png",
    "scheme": "candelaia",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo-candela.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.candelaia.app"
    },
    "android": {
      "package": "com.candelaia.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-candela.png",
        "backgroundColor": "#09090B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5835e18-be21-418f-b111-1f8e99a2226e"
      }
    },
    "owner": "sebastianpariachi.l"
  }
}
